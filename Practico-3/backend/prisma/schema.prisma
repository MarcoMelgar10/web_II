generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  FOLLOWER
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorProfile CreatorProfile?
  posts          Post[]
  donationsGiven Donation[]      @relation("DonationFollower")
  donationsReceived Donation[]   @relation("DonationCreator")
  comments       Comment[]
  favoritesGiven Favorite[]      @relation("FavoriteFollower")
  favoritesReceived Favorite[]   @relation("FavoriteCreator")
  goals          Goal[]

  @@map("users")
}

model CreatorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  bio         String?
  avatarUrl   String?
  bannerUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("creator_profiles")
}

model Goal {
  id          String   @id @default(cuid())
  creatorId   String
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("goals")
}

model Post {
  id        String   @id @default(cuid())
  creatorId String
  text      String
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator  User      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  comments Comment[]

  @@map("posts")
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  followerId String
  text       String
  createdAt  DateTime @default(now())

  post     Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  follower User @relation(fields: [followerId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model Donation {
  id         String   @id @default(cuid())
  followerId String
  creatorId  String
  flanes     Int
  unitPrice  Decimal  @db.Decimal(10, 2)
  type       String   @default("FLAN")
  createdAt  DateTime @default(now())

  follower User @relation("DonationFollower", fields: [followerId], references: [id], onDelete: Cascade)
  creator  User @relation("DonationCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("donations")
}

model Favorite {
  id         String   @id @default(cuid())
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())

  follower User @relation("FavoriteFollower", fields: [followerId], references: [id], onDelete: Cascade)
  creator  User @relation("FavoriteCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([followerId, creatorId])
  @@map("favorites")
}
